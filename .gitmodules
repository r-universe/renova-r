[submodule ".registry"]
	path = .registry
	url = https://github.com/renova-r/renova-r.r-universe.dev
	branch = HEAD
[submodule "BBSSL"]
	path = BBSSL
	url = https://github.com/renova-r/BBSSL
	branch = renova-0.1.0.9001
